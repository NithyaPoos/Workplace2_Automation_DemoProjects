		int x=drag.getLocation().getX();
	    int y=drag.getLocation().getY();
		a.dragAndDropBy(drag,10,5 ).build().perform();
		System.out.println("after drop :: "+drag.getLocation());
		
		//axis restricted
		WebElement axislink=driver.findElement(By.xpath("//a[@id='draggableExample-tab-axisRestriction']"));
		axislink.click();
		WebElement drag1=driver.findElement(By.xpath("//div[@id='restrictedX']"));
		WebElement drag2=driver.findElement(By.xpath("//div[@id='restrictedY']"));
	
		System.out.println("before drop1 :: "+drag1.getLocation());
		int x1=drag.getLocation().getX();
