	public void resizable(WebDriver driver,WebDriverWait wait,JavascriptExecutor js) 
	{
	driver.navigate().to("https://demoqa.com/resizable");
	WebElement resizableElement=driver.findElement(By.id("resizableBoxWithRestriction"));
	WebElement resizableHandle=driver.findElement(By.xpath("//*[@id=\"resizableBoxWithRestriction\"]/span"));
	wait.until(ExpectedConditions.elementToBeClickable(resizableElement));
	// Scroll the resizable element into view
    js.executeScript("arguments[0].scrollIntoView(true);", resizableElement);
	// Get the initial size of the resizable element
    int initialWidth = resizableElement.getSize().getWidth();
    int initialHeight = resizableElement.getSize().getHeight();
    System.out.println("Initial size: " + initialWidth + "x" + initialHeight);

	Actions a=new Actions(driver);
//a.dragAndDropBy(resizableHandle, 100, 100).build().perform();
	a.clickAndHold(resizableHandle).moveByOffset(-100,-100).release().build().perform();
	// Wait for a moment to ensure the resize action is completed
    try {
        Thread.sleep(1000); // Adjust the sleep duration if necessary
    } catch (InterruptedException e) {
        e.printStackTrace();
    }
	// Get the new size of the resizable element
    int newWidth = resizableElement.getSize().getWidth();
    int newHeight = resizableElement.getSize().getHeight();
    System.out.println("New size: " + newWidth + "x" + newHeight);
		
    WebElement box1=driver.findElement(By.xpath("//*[@id=\"resizable\"]"));
    WebElement handle1=driver.findElement(By.xpath("//*[@id=\"resizable\"]/span"));
   int x=box1.getSize().width;
   int y=box1.getSize().height;
   System.out.println("old size second : " + x + "x" + y);
   wait.until(ExpectedConditions.elementToBeClickable(box1));
	// Scroll the resizable element into view
   js.executeScript("arguments[0].scrollIntoView(true);", box1);
    a.clickAndHold(handle1).moveByOffset(-20, -20).release().build().perform();
    int x1=box1.getSize().width;
    int y1=box1.getSize().height; 
    System.out.println("New size second : " + x1 + "x" + y1);
	}
