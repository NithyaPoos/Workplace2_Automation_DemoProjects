	public void sortable(WebDriver driver,WebDriverWait wait,JavascriptExecutor js,Actions a) throws InterruptedException {
		 // Navigate to the DemoQA sortable page
        driver.navigate().to("https://demoqa.com/sortable");
    
        String currentwindowHandle=driver.getWindowHandle();
        Set<String> allWindowHandles=driver.getWindowHandles();
        for(String handle:allWindowHandles) 
        {
        	if(!handle.equals(currentwindowHandle))
        		driver.switchTo().window(currentwindowHandle);
        	//driver.close();
        }
        
        // Locate the list of sortable items
        List<WebElement> sortableItems = driver.findElements(By.xpath("//div[@id='demo-tabpane-list']//div[@class='list-group-item list-group-item-action']"));
        // Sorting by reversing the order of the list items
      System.out.println("sortableitems :: before ");
      sortableItems.forEach(item -> System.out.print(item.getText() + " "));
        int totalItems = sortableItems.size();
        for (int i = 1; i < totalItems; i++) {
            WebElement sourceElement = sortableItems.get(i);  // Current element
            WebElement targetElement = sortableItems.get(totalItems- i);  
          
            //Drag and drop operation
            a.clickAndHold(sourceElement)
           // .moveByOffset(0, 20)// Move slightly downward to avoid overlap
            .moveToElement(targetElement)
            .release()
            .build()
            .perform();
         // Optionally wait between each sort operation for observation
            Thread.sleep(1000);  // 1-second delay to observe the sorting process
       } 
        System.out.println("sortableitems :: after ");
        sortableItems.forEach(item -> System.out.print(item.getText() + " "));
        System.out.println("done sorting");
	}
       
	
