		//driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(1000));
		WebElement tab1=driver.findElement(By.cssSelector("#tabButton"));
		wait.until(ExpectedConditions.elementToBeClickable(tab1));
	    js.executeScript("arguments[0].scrollIntoView(true);", args)
		js.executeScript("arguments[0].click();",tab1);
		js.executeScript("arguments[0].click();",tab1);
		
		int count=0;
		for(String t:driver.getWindowHandles())
		{
			count=count+1;
		}
		System.out.println("count of tabs opened "+count);
		
		
		List<String> tabs=new ArrayList<String>(driver.getWindowHandles());
		driver.switchTo().window(tabs.get(0));
