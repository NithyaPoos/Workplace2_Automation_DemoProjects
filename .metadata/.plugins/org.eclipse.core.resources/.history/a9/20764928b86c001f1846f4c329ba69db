package demoqapageObjects;

import org.openqa.selenium.By;
import org.openqa.selenium.JavascriptExecutor;
import org.openqa.selenium.Keys;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.interactions.Actions;
import org.openqa.selenium.support.FindBy;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.openqa.selenium.support.ui.WebDriverWait;

public class FormsPage extends BasePage{


	@FindBy(xpath="//*[@id=\"item-0\"]/span[text()='Practice Form']") 
	WebElement btn_practiceform_click;
	@FindBy(id="firstName") 
	WebElement txt_firstname;
	@FindBy(id="lastName")
	WebElement txt_lastname;
	@FindBy(xpath="//input[@id='userEmail']")
	WebElement txt_useremail;
	@FindBy(xpath="//*[@id=\"genterWrapper\"]/div[2]/div[2]/label")
	WebElement radio_btn_gender;
	@FindBy(xpath="//*[@id=\"userNumber\"]") 
	WebElement phone;
	@FindBy(xpath="//*[@id='dateOfBirthInput']")
	WebElement datePicker;
	@FindBy(xpath = "//div[contains(@class, 'react-datepicker__day') and text()='4']")
	WebElement dateElement;
	@FindBy(id="subjectsInput")
	WebElement txt_subject;
//	@FindBy(xpath="//div[contains(@class, 'subjects-auto-complete__option') and text()='Maths']")
//    WebElement input_subject; 
	 WebDriverWait wait;
	    JavascriptExecutor js;
	    Actions actions;

	    public FormsPage(WebDriver driver) {
	        super(driver);
	        wait = getWebDriverWait();
	        js = getJavascriptExecutor();
	        actions = new Actions(driver);
	    }
	    
	public void practice_form_click()
	{
		btn_practiceform_click.click();
	}
	public void enter_user_firstname(String username) 
	{
		txt_firstname.sendKeys(username);
	}
	public void enter_user_lastname(String lastname) {
		txt_lastname.sendKeys(lastname);
	}
	public void enter_user_email(String useremail) {
		txt_useremail.sendKeys(useremail);
	}
	public void choose_gender() {
		radio_btn_gender.click();
	}
	public void enter_user_phone(String telephone) {
		phone.sendKeys(telephone);
	}
	public void enter_datefield() {
		wait.until(ExpectedConditions.elementToBeClickable(datePicker));
		js.executeScript("arguments[0].scrollIntoView(true);", datePicker);
		datePicker.click();
		dateElement.click();
	}
	  public void enter_subject(String[] values) {
	        for (String value : values) {
	            txt_subject.sendKeys(value);
	            //xpath("//div[contains(@class, 'subjects-auto-complete__option') and text()='Maths']")));
	            WebElement subjectOption = wait.until(ExpectedConditions.visibilityOfElementLocated(
	                By.xpath("//div[contains(@class, 'subjects-auto-complete__option') and text()='" + value + "']")));
	            actions.moveToElement(subjectOption).click().perform();
	            txt_subject.sendKeys(Keys.ENTER);
	            //subjectOption.click();
	  	        // Adding a small delay to ensure the field is ready for the next input
	            try {
	                Thread.sleep(500); // Adjust the delay as needed
	            } catch (InterruptedException e) {
	                e.printStackTrace();
	            }   //txt_subject.clear(); // Clear the input field for the next subject
	        
	        }
	    }
