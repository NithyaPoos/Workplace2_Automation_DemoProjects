	public void enter_datefield(String day,String month,String year) {
	
		wait.until(ExpectedConditions.elementToBeClickable(datePicker));
		js.executeScript("arguments[0].scrollIntoView(true);", datePicker);
		datePicker.click();
		monthDropdown.sendKeys(month);
		yearDropdown.sendKeys(year);
		// Dynamically locate the day element using XPath
        String dynamicDayXPath = "//div[contains(@class, 'react-datepicker__day') and text()='" + day + "']";
        WebElement dayElement = driver.findElement(By.xpath(dynamicDayXPath));
        dayElement.click();
		//dateElement.click();
	}
	public void enter_subject(String[] values) {
		//WebElement subjectsInput = wait.until(ExpectedConditions.elementToBeClickable(txt_subject));		
	   // List<String> selectedSubjects = new ArrayList<>();  // Store the selected subjects
		wait.until(ExpectedConditions.elementToBeClickable(txt_subject));	
		 // Clear the input before adding new values
	    txt_subject.clear();
	    for (String value : values) {
	        // Type the subject value
	        txt_subject.sendKeys(value);// Enter the value
	        txt_subject.sendKeys(Keys.ENTER); 
	        //txt_subject.sendKeys(",");// Add comma as delimiter
	        // Simulate pressing Enter after each value to confirm the subject

	    }
	    
	    String subjectsValue = txt_subject.getAttribute("value");
	   // String subjectsValue = txt_subject.getAttribute("value").trim();  // Ensure no trailing spaces
        System.out.println("Subjects: " + subjectsValue);
	    }
